# ===================================================================
# KONFIGURASI ENVIRONMENT (TEMPLATE / CONTOH)
# PERINGATAN KEAMANAN:
# Jangan pernah mengisi kredensial nyata di file ini (.env.example).
# Salin file ini menjadi .env lalu isi nilai rahasia Anda sendiri.
# File .env sudah masuk di .gitignore dan TIDAK AKAN di-commit ke Git.
# ===================================================================

# 1. URL Database PostgreSQL dari Neon (Gunakan mode pooled untuk Serverless)
# Format contoh: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Secret Key untuk penandatanganan JWT Session (Wajib minimal 32 karakter acak yang kuat)
# Panduan pembuatan string rahasia: jalankan di terminal: openssl rand -base64 32
JWT_SECRET="ganti_dengan_string_rahasia_acak_minimal_32_karakter_contoh_9f8e7d6c5b4a3210"

# 3. Environment Runtime (development / production)
NODE_ENV="development"

# 4. Kredensial untuk Database Seeding (Pembuatan Akun Awal untuk Demo)
# PERINGATAN: Jangan isi password nyata di sini! Isi nilai aman di file .env lokal Anda.
SEED_ADMIN_NAME="Komandan Keamanan Kampus"
SEED_ADMIN_EMAIL="admin.keamanan@kampus.ac.id"
SEED_ADMIN_PASSWORD="isi_password_admin_yang_kuat_di_env_lokal"

SEED_USER_NAME="Mahasiswa Pelapor"
SEED_USER_EMAIL="mahasiswa@kampus.ac.id"
SEED_USER_PASSWORD="isi_password_user_yang_kuat_di_env_lokal"
