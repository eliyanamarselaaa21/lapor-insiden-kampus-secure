// ===================================================================
// Skema Prisma Database untuk SIPEKAN
// Sistem Pelaporan Insiden Keamanan & Pelanggaran Kampus
// Target Database: PostgreSQL (Neon Serverless)
// Keamanan: Zero Raw-SQL, Sanitized ORM Query, Role-Based Access Control
// ===================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// ENUMS (Standarisasi Nilai Tetap & Pencegah Input Sembarangan)
// -------------------------------------------------------------------

// Peran Pengguna (Role-Based Access Control / RBAC)
enum Role {
  ADMIN // Tim Keamanan / Petugas Investigasi Kampus
  USER  // Mahasiswa atau Staf Kampus (Pelapor)
}

// Kategori Pelaporan Insiden di Lingkungan Kampus
enum KategoriInsiden {
  KEHILANGAN  // Kehilangan barang, pencurian (laptop, motor, helm, dompet, dll.)
  PELANGGARAN // Pelanggaran tata tertib kampus, narkoba/miras, perusakan fasilitas
  SIBER       // Insiden siber (phishing, peretasan akun kampus, ransomware, data leak)
  LAINNYA     // Insiden keamanan fisik lainnya / situasi darurat kampus
}

// Alur Status Penanganan Laporan Insiden
enum StatusLaporan {
  BARU     // Laporan baru dikirim oleh pelapor, belum diverifikasi petugas
  DIPROSES // Laporan valid dan sedang ditangani/diinvestigasi oleh petugas keamanan
  SELESAI  // Tindakan pengamanan/penyelesaian telah selesai dilakukan
}

// -------------------------------------------------------------------
// MODELS (Tabel Database)
// -------------------------------------------------------------------

// 1. Model Pengguna (User)
model User {
  id           String           @id @default(cuid())
  nama         String           // Nama lengkap mahasiswa/staf
  email        String           @unique // Email kampus unik (digunakan untuk login)
  passwordHash String           // Hasil enkripsi hash bcrypt (Bukan plain text!)
  role         Role             @default(USER) // Default role adalah USER (prinsip Least Privilege)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relasi: 1 Pengguna dapat membuat banyak Laporan Insiden (1-to-N)
  reports      IncidentReport[]

  // Relasi: 1 Pengguna dapat memiliki banyak jejak log aktivitas (1-to-N)
  activityLogs ActivityLog[]

  @@map("users")
}

// 2. Model Laporan Insiden (IncidentReport)
model IncidentReport {
  id           String          @id @default(cuid())
  judul        String          // Ringkasan singkat insiden
  deskripsi    String          @db.Text // Kronologi lengkap dan detail kejadian
  lokasi       String          // Lokasi spesifik kejadian di lingkungan kampus
  kategori     KategoriInsiden @default(LAINNYA) // Kategori insiden
  status       StatusLaporan   @default(BARU) // Status penanganan awal selalu BARU
  catatanAdmin String?         @db.Text // Catatan investigasi / tindak lanjut petugas keamanan
  
  // Relasi ke tabel User (Pelapor)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Index untuk mempercepat query pencarian dan penyaringan data di dashboard
  @@index([userId])
  @@index([status])
  @@index([kategori])
  @@map("incident_reports")
}

// 3. Model Log Aktivitas Keamanan (ActivityLog / Audit Log)
// Digunakan untuk investigasi forensik dan audit trail keamanan sistem siber
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  // Opsional (Bisa null jika aksi dilakukan sebelum login/gagal autentikasi)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull) // Jika user dihapus, log tetap tersimpan
  aksi      String   // Kode aksi (e.g. AUTH_LOGIN_SUCCESS, REPORT_CREATE, STATUS_UPDATE)
  detail    String?  @db.Text // Deskripsi aktivitas (tanpa menyimpan kredensial sensitif)
  ip        String?  // Alamat IP klien pengirim request untuk deteksi ancaman
  createdAt DateTime @default(now())

  // Index untuk pencarian log berdasarkan user atau jenis aksi
  @@index([userId])
  @@index([aksi])
  @@map("activity_logs")
}
